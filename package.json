{
  "name": "pkgbuild-vscode",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "turbo run lint format:check typecheck test",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "package": "turbo run package",
    "fixtures:sync": "node scripts/sync-fixtures.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:watch": "vitest --watch",
    "gen:licenses": "node scripts/gen-licenses.ts",
    "gen:grammar": "node scripts/gen-grammar.ts",
    "gen": "pnpm run gen:licenses && pnpm run gen:grammar"
  },
  "devDependencies": {
    "@pkgbuild-lsp/data": "workspace:*",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
