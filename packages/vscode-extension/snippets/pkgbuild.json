{
  "Basic PKGBUILD": {
    "prefix": "pkgbuild",
    "description": "A complete PKGBUILD skeleton for a source tarball",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "pkgname=${3:name}",
      "pkgver=${4:1.0.0}",
      "pkgrel=1",
      "pkgdesc=\"${5:Short description}\"",
      "arch=('${6|x86_64,any,aarch64|}')",
      "url=\"${7:https://example.com}\"",
      "license=('${8:GPL-3.0-or-later}')",
      "depends=(${9:'glibc'})",
      "makedepends=(${10})",
      "source=(\"\\$pkgname-\\$pkgver.tar.gz::${11:https://example.com/archive/v\\$pkgver.tar.gz}\")",
      "sha256sums=('SKIP')",
      "",
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\t$0",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tmake DESTDIR=\"\\$pkgdir\" install",
      "}"
    ]
  },
  "VCS (-git) PKGBUILD": {
    "prefix": "pkgbuild-git",
    "description": "A PKGBUILD for a git checkout, with a pkgver() function",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "pkgname=${3:name}-git",
      "pkgver=r0.0000000",
      "pkgrel=1",
      "pkgdesc=\"${4:Short description}\"",
      "arch=('${5|x86_64,any|}')",
      "url=\"${6:https://example.com}\"",
      "license=('${7:GPL-3.0-or-later}')",
      "depends=(${8:'glibc'})",
      "makedepends=('git')",
      "provides=(\"${3:name}\")",
      "conflicts=(\"${3:name}\")",
      "source=(\"\\$pkgname::git+${9:https://github.com/user/repo}.git\")",
      "b2sums=('SKIP')",
      "",
      "pkgver() {",
      "\tcd \"\\$srcdir/\\$pkgname\"",
      "\tprintf \"r%s.%s\" \"\\$(git rev-list --count HEAD)\" \"\\$(git rev-parse --short HEAD)\"",
      "}",
      "",
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgname\"",
      "\t$0",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$pkgname\"",
      "\tmake DESTDIR=\"\\$pkgdir\" install",
      "}"
    ]
  },
  "Binary (-bin) PKGBUILD": {
    "prefix": "pkgbuild-bin",
    "description": "A PKGBUILD repackaging a prebuilt binary, with per-architecture sources",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "pkgname=${3:name}-bin",
      "pkgver=${4:1.0.0}",
      "pkgrel=1",
      "pkgdesc=\"${5:Short description}\"",
      "arch=('x86_64' 'aarch64')",
      "url=\"${6:https://example.com}\"",
      "license=('${7:MIT}')",
      "provides=(\"${3:name}=\\$pkgver\")",
      "conflicts=(\"${3:name}\")",
      "source_x86_64=(\"\\$pkgname-\\$pkgver-x86_64.tar.gz::${8:https://example.com/v\\$pkgver/linux-amd64.tar.gz}\")",
      "source_aarch64=(\"\\$pkgname-\\$pkgver-aarch64.tar.gz::${9:https://example.com/v\\$pkgver/linux-arm64.tar.gz}\")",
      "sha256sums_x86_64=('SKIP')",
      "sha256sums_aarch64=('SKIP')",
      "",
      "package() {",
      "\tinstall -Dm755 \"\\$srcdir/${10:binary}\" \"\\$pkgdir/usr/bin/${10:binary}\"",
      "\t$0",
      "}"
    ]
  },
  "Split package PKGBUILD": {
    "prefix": "pkgbuild-split",
    "description": "A PKGBUILD producing several packages from one source",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "pkgbase=${3:name}",
      "pkgname=('${3:name}' '${3:name}-docs')",
      "pkgver=${4:1.0.0}",
      "pkgrel=1",
      "arch=('x86_64')",
      "url=\"${5:https://example.com}\"",
      "license=('${6:GPL-3.0-or-later}')",
      "makedepends=(${7})",
      "source=(\"\\$pkgbase-\\$pkgver.tar.gz::${8:https://example.com/v\\$pkgver.tar.gz}\")",
      "sha256sums=('SKIP')",
      "",
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgbase-\\$pkgver\"",
      "\t$0",
      "}",
      "",
      "package_${3:name}() {",
      "\tpkgdesc=\"${9:Short description}\"",
      "\tdepends=('glibc')",
      "\tcd \"\\$srcdir/\\$pkgbase-\\$pkgver\"",
      "\tmake DESTDIR=\"\\$pkgdir\" install",
      "}",
      "",
      "package_${3:name}-docs() {",
      "\tpkgdesc=\"${9:Short description} (documentation)\"",
      "\tarch=('any')",
      "\tcd \"\\$srcdir/\\$pkgbase-\\$pkgver\"",
      "\tinstall -Dm644 README.md \"\\$pkgdir/usr/share/doc/\\$pkgbase/README.md\"",
      "}"
    ]
  },
  "Python PKGBUILD": {
    "prefix": "pkgbuild-python",
    "description": "A PKGBUILD for a PEP 517 Python package",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "_name=${3:name}",
      "pkgname=python-\\$_name",
      "pkgver=${4:1.0.0}",
      "pkgrel=1",
      "pkgdesc=\"${5:Short description}\"",
      "arch=('any')",
      "url=\"${6:https://github.com/user/repo}\"",
      "license=('${7:MIT}')",
      "depends=('python')",
      "makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')",
      "source=(\"https://pypi.io/packages/source/\\${_name::1}/\\$_name/\\$_name-\\$pkgver.tar.gz\")",
      "sha256sums=('SKIP')",
      "",
      "build() {",
      "\tcd \"\\$srcdir/\\$_name-\\$pkgver\"",
      "\tpython -m build --wheel --no-isolation",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$_name-\\$pkgver\"",
      "\tpython -m installer --destdir=\"\\$pkgdir\" dist/*.whl",
      "\t$0",
      "}"
    ]
  },
  "Rust PKGBUILD": {
    "prefix": "pkgbuild-rust",
    "description": "A PKGBUILD for a Cargo project",
    "body": [
      "# Maintainer: ${1:Your Name} <${2:you@example.com}>",
      "",
      "pkgname=${3:name}",
      "pkgver=${4:1.0.0}",
      "pkgrel=1",
      "pkgdesc=\"${5:Short description}\"",
      "arch=('x86_64' 'aarch64')",
      "url=\"${6:https://github.com/user/repo}\"",
      "license=('${7:MIT}')",
      "depends=('gcc-libs')",
      "makedepends=('cargo')",
      "source=(\"\\$pkgname-\\$pkgver.tar.gz::\\$url/archive/v\\$pkgver.tar.gz\")",
      "sha256sums=('SKIP')",
      "",
      "prepare() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\texport RUSTUP_TOOLCHAIN=stable",
      "\tcargo fetch --locked --target \"\\$(rustc -vV | sed -n 's/host: //p')\"",
      "}",
      "",
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\texport RUSTUP_TOOLCHAIN=stable",
      "\texport CARGO_TARGET_DIR=target",
      "\tcargo build --frozen --release --all-features",
      "}",
      "",
      "check() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\texport RUSTUP_TOOLCHAIN=stable",
      "\tcargo test --frozen --all-features",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tinstall -Dm755 \"target/release/\\$pkgname\" \"\\$pkgdir/usr/bin/\\$pkgname\"",
      "\t$0",
      "}"
    ]
  },
  "Meson PKGBUILD": {
    "prefix": "pkgbuild-meson",
    "description": "A PKGBUILD for a Meson project",
    "body": [
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tarch-meson . build",
      "\tmeson compile -C build",
      "}",
      "",
      "check() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tmeson test -C build --print-errorlogs",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tmeson install -C build --destdir \"\\$pkgdir\"",
      "\t$0",
      "}"
    ]
  },
  "CMake PKGBUILD": {
    "prefix": "pkgbuild-cmake",
    "description": "A PKGBUILD for a CMake project",
    "body": [
      "build() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tcmake -B build -S . \\\\",
      "\t\t-DCMAKE_BUILD_TYPE=None \\\\",
      "\t\t-DCMAKE_INSTALL_PREFIX=/usr \\\\",
      "\t\t-Wno-dev",
      "\tcmake --build build",
      "}",
      "",
      "package() {",
      "\tcd \"\\$srcdir/\\$pkgname-\\$pkgver\"",
      "\tDESTDIR=\"\\$pkgdir\" cmake --install build",
      "\t$0",
      "}"
    ]
  },
  "pkgver() for git": {
    "prefix": "pkgver-git",
    "description": "Compute pkgver from git revision count and short hash",
    "body": [
      "pkgver() {",
      "\tcd \"\\$srcdir/\\$pkgname\"",
      "\tprintf \"r%s.%s\" \"\\$(git rev-list --count HEAD)\" \"\\$(git rev-parse --short HEAD)\"",
      "}"
    ]
  },
  "pkgver() for git tags": {
    "prefix": "pkgver-git-tag",
    "description": "Compute pkgver from the most recent git tag",
    "body": [
      "pkgver() {",
      "\tcd \"\\$srcdir/\\$pkgname\"",
      "\tgit describe --long --tags --abbrev=7 | sed 's/^v//;s/\\\\([^-]*-g\\\\)/r\\\\1/;s/-/./g'",
      "}"
    ]
  },
  "install scriptlet": {
    "prefix": "install-scriptlet",
    "description": "A .install file with the common pacman hooks",
    "body": [
      "post_install() {",
      "\t$0",
      "}",
      "",
      "post_upgrade() {",
      "\tpost_install \"\\$@\"",
      "}",
      "",
      "post_remove() {",
      "\t:",
      "}"
    ]
  }
}
