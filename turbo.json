{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "syntaxes/**",
        "snippets/**",
        "package.json",
        "esbuild.config.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**",
        "vitest.config.ts",
        "../../vitest.shared.ts",
        "../../fixtures/**"
      ],
      "outputs": []
    },
    "package": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "*.vsix"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
