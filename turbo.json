{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "//#lint": {
      "inputs": [
        "packages/*/src/**/*.ts",
        "packages/*/*.ts",
        "scripts/**/*.ts",
        "vitest.shared.ts",
        "tsconfig.base.json",
        "packages/*/tsconfig.json",
        ".oxlintrc.json"
      ],
      "outputs": []
    },
    "//#format:check": {
      "inputs": [
        "packages/*/src/**/*.ts",
        "packages/*/*.ts",
        "packages/*/*.json",
        "packages/vscode-extension/snippets/*.json",
        "scripts/**/*.ts",
        ".github/**/*.yml",
        ".vscode/*.json",
        "*.ts",
        "*.json",
        "*.yaml",
        "oxfmt.config.ts"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "syntaxes/**", "snippets/**", "package.json", "esbuild.config.ts"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "vitest.config.ts", "../../vitest.shared.ts", "../../fixtures/**"],
      "outputs": []
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["*.vsix"]
    },
    "clean": {
      "cache": false
    }
  }
}
